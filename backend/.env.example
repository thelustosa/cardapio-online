# ============================================================
# ZEST MENU — Modelo de Variáveis de Ambiente (.env.example)
# ============================================================
# Copie este arquivo para ".env" e preencha com seus dados:
#   cp .env.example .env
#
# ⚠️ NUNCA comite o arquivo .env com dados reais para o GitHub!

# ── Banco de Dados MySQL ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=zestmenu_db

# ── Segurança JWT ─────────────────────────────────────────────
# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=MUDE_ESTA_CHAVE_EM_PRODUCAO

# ── Chave de Criptografia (AES-256) ──────────────────────────
# Gere uma chave de 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=636465666768696a6b6c6d6e6f707172737475767778797a3031323334353637

# ── Configurações de Ambiente ─────────────────────────────────
NODE_ENV=development
PORT=3002
GENERATE_SOURCEMAP=false
